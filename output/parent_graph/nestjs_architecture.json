  "event_patterns": [
    {
      "event_name": "sale.completed",
      "trigger": "When POS transaction is successfully processed",
      "consumers": [
        "CustomerModule",
        "InventoryModule"
      ],
      "purpose": "Update loyalty points and reduce stock"
    },
    {
      "event_name": "inventory.low_stock",
      "trigger": "When item stock falls below minimum threshold",
      "consumers": [
        "SupplierModule",
        "NotificationModule"
      ],
      "purpose": "Trigger reorder alerts and notifications"
    },
    {
      "event_name": "purchase_order.received",
      "trigger": "When supplier delivery is marked as received",
      "consumers": [
        "InventoryModule"
      ],
      "purpose": "Update location inventory levels"
    },
    {
      "event_name": "loyalty.points_earned",
      "trigger": "When customer completes qualifying purchase",
      "consumers": [
        "CustomerModule",
        "NotificationModule"
      ],
      "purpose": "Update points balance and send notifications"
    }
  ],
